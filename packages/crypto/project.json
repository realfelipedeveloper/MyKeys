{
  "name": "crypto",
  "projectType": "library",
  "sourceRoot": "packages/crypto/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/crypto"],
      "options": {
        "command": "pnpm exec tsc -p packages/crypto/tsconfig.lib.json && node tools/build-package.mjs crypto"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/crypto"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/crypto/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs crypto --test"
      }
    }
  },
  "tags": ["scope:crypto", "type:package", "critical:security"]
}
