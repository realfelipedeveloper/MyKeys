{
  "name": "contracts",
  "projectType": "library",
  "sourceRoot": "packages/contracts/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/contracts"],
      "options": {
        "command": "node tools/build-package.mjs contracts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs contracts --lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs contracts --typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs contracts --test"
      }
    }
  },
  "tags": ["scope:contracts", "type:package"]
}
