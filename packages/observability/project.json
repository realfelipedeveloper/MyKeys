{
  "name": "observability",
  "projectType": "library",
  "sourceRoot": "packages/observability/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/observability"],
      "options": {
        "command": "pnpm exec tsc -p packages/observability/tsconfig.lib.json && node tools/build-package.mjs observability"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/observability"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/observability/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs observability --test"
      }
    }
  },
  "tags": ["scope:observability", "type:package"]
}
