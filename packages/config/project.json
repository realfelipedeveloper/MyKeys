{
  "name": "config",
  "projectType": "library",
  "sourceRoot": "packages/config/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/config"],
      "options": {
        "command": "pnpm exec tsc -p packages/config/tsconfig.lib.json && node tools/build-package.mjs config"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/config"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/config/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs config --test"
      }
    }
  },
  "tags": ["scope:config", "type:package"]
}
