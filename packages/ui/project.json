{
  "name": "ui",
  "projectType": "library",
  "sourceRoot": "packages/ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/ui"],
      "options": {
        "command": "node tools/build-package.mjs ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs ui --lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs ui --typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs ui --test"
      }
    }
  },
  "tags": ["scope:ui", "type:package"]
}
