{
  "name": "testing",
  "projectType": "library",
  "sourceRoot": "packages/testing/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/testing"],
      "options": {
        "command": "pnpm exec tsc -p packages/testing/tsconfig.lib.json && node tools/build-package.mjs testing"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint packages/testing"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p packages/testing/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-packages.mjs testing --test"
      }
    }
  },
  "tags": ["scope:testing", "type:package"]
}
