{
  "name": "worker",
  "projectType": "application",
  "sourceRoot": "apps/worker/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/app-runtime.mjs worker"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/worker"],
      "options": {
        "command": "pnpm exec tsc -p apps/worker/tsconfig.app.json && node tools/build-app.mjs worker"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint apps/worker"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/worker/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs worker --test"
      }
    }
  },
  "tags": ["scope:worker", "type:app"]
}
