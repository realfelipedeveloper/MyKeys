{
  "name": "worker",
  "projectType": "application",
  "sourceRoot": "apps/worker/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/worker/src/main.mjs"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/worker"],
      "options": {
        "command": "node tools/build-app.mjs worker"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs worker --lint"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs worker --typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs worker --test"
      }
    }
  },
  "tags": ["scope:worker", "type:app"]
}
