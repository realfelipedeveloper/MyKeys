{
  "name": "notification-api",
  "projectType": "application",
  "sourceRoot": "apps/notification-api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/app-runtime.mjs notification-api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/notification-api"],
      "options": {
        "command": "pnpm exec tsc -p apps/notification-api/tsconfig.app.json && node tools/build-app.mjs notification-api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint apps/notification-api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/notification-api/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs notification-api --test"
      }
    }
  },
  "tags": ["scope:notification-api", "type:app"]
}
