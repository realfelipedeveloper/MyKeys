{
  "name": "core-api",
  "projectType": "application",
  "sourceRoot": "apps/core-api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/app-runtime.mjs core-api"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/core-api"],
      "options": {
        "command": "pnpm exec tsc -p apps/core-api/tsconfig.app.json && node tools/build-app.mjs core-api"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec eslint apps/core-api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit -p apps/core-api/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/check-apps.mjs core-api --test"
      }
    }
  },
  "tags": ["scope:core-api", "type:app"]
}
